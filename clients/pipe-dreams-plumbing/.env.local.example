# Copy this file to .env.local and fill in your values.
# Everything here is read server-side only and never exposed to the browser.

# --- Required for the AI receptionist ---------------------------------------
# Without this, /api/intake returns 503 and the chat widget falls back to a
# "call us" button. The rest of the site works fine.
ANTHROPIC_API_KEY=sk-ant-...

# --- Lead delivery -----------------------------------------------------------
# Configure at least ONE of the two blocks below, or captured leads go nowhere
# and the receptionist will tell customers to call instead of promising a
# callback it can't deliver.

# Text each lead to the owner's phone (recommended for a shop this size).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
LEAD_SMS_TO=+17027680428

# Email each lead to the office inbox.
RESEND_API_KEY=
LEAD_EMAIL_TO=office@example.com
LEAD_EMAIL_FROM=leads@pipedreamsplumbingco.com
