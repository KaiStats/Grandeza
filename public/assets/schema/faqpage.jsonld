{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://grandeza.io/tcpa-compliance-hvac-plumbing#faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is TCPA compliance for HVAC and plumbing contractors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Telephone Consumer Protection Act (TCPA) requires prior express written consent before sending automated texts or calls for marketing, and prior express consent for service messages. For HVAC and plumbing shops that send appointment reminders, dispatch texts or use AI phone agents, compliance means capturing and storing provable consent, honoring Do-Not-Call requests, and keeping an auditable record of every message."
      }
    },
    {
      "@type": "Question",
      "name": "How much can a TCPA violation cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TCPA statutory damages are $500 per violating message, rising to $1,500 per message for willful or knowing violations. Because damages are per message, a single automated blast to a non-consented or Do-Not-Call list can quickly reach five or six figures before legal defense costs."
      }
    },
    {
      "@type": "Question",
      "name": "Do I have to replace my texting or dispatch software to be compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Grandeza hardens the tools you already use — such as Twilio, your CRM and your intake bot — by adding signed consent capture, an immutable audit trail, Do-Not-Call screening and rate limits around them, without a rip-and-replace."
      }
    },
    {
      "@type": "Question",
      "name": "How do I check if my current intake is TCPA compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Grandeza's free 3-minute scan grades your live SMS, call and web intake against 16 controls and returns a Grandeza Score from 0 to 100 with a control-by-control breakdown, so you can see exactly where the exposure is before spending anything."
      }
    }
  ]
}
