# Cloudflare Pages — response headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers on everything
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # NOTE: add "; preload" above and submit to hstspreload.org only when you're
  # certain every subdomain will always be HTTPS — it's hard to undo.

# HTML: always revalidate so content updates ship immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted static assets: cache hard (rename the file to bust)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted images (once moved off the Higgsfield CDN — see deploy guide)
/img/*
  Cache-Control: public, max-age=31536000, immutable

# robots + sitemap: short cache
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# ── Content-Security-Policy (starter — currently permissive) ────────────────
# The pages use inline <style>/<script> and one remote image host, so a strict
# CSP would break them as-is. Ship the line below once you've (a) self-hosted
# images and (b) moved inline CSS/JS to /assets with nonces or hashes.
#
# IMPORTANT: the google/cloudflare origins below are what analytics needs. Omit
# them and GA4 is blocked silently — the page looks fine and no data arrives.
#
# /*
#   Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
