{
  // Cloudflare Worker — static-assets only (no server code).
  // Serves the built marketing site in /public. `npx wrangler deploy` reads this.
  "name": "grandeza2026",
  "compatibility_date": "2026-07-20",
  // Bind the live domains to this worker so `wrangler deploy` keeps them attached.
  "routes": [
    { "pattern": "grandeza.io", "custom_domain": true },
    { "pattern": "www.grandeza.io", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    // Clean URLs: /about serves public/about.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
